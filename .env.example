# Server Port & Environment
PORT=5001
NODE_ENV=production

# Database & Data Directory (Optional - for persistent cloud volume mounts)
# DATA_DIR=/var/data/job-automator

# Playwright Browser Automation Configuration
# Set HEADLESS=true for cloud headless execution (Render, Railway, DigitalOcean, Docker)
HEADLESS=true

# Optional: Connect to remote browser cluster (e.g. Browserless.io)
# BROWSER_WS_ENDPOINT=wss://chrome.browserless.io?token=YOUR_BROWSERLESS_TOKEN

# AI Resume Re-writing API Key (Optional - Google Gemini)
# GEMINI_API_KEY=AIzaSy...

# Mobile & Cloud Push Notifications
# Telegram Bot Token & Chat ID (Android / iOS Push Alerts)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJK...
# TELEGRAM_CHAT_ID=987654321

# Discord Webhook URL (Mobile / Desktop Embed Alerts)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
